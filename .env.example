# =============================================================================
# ServerGen AI — Environment Configuration
# =============================================================================
# Copy this file to .env:
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux / macOS)
# =============================================================================

# Application
APP_NAME=ServerGen AI
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Database
# Option A (Default zero-setup local development): SQLite with WAL mode
DATABASE_URL=sqlite+aiosqlite:///./servergen-ai.db
# Option B (Production): PostgreSQL with asyncpg
# DATABASE_URL=postgresql+asyncpg://servergen:changeme@localhost:5432/servergen

# CORS Origins (For custom frontend testing: Next.js, Vite, React, Vue, Svelte, Angular)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080","http://localhost:4200","http://127.0.0.1:4200","http://localhost:8000","http://127.0.0.1:8000"]

# JWT Security
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b

# Initial Admin User (used during database seeding)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@servergen.local
ADMIN_PASSWORD=admin

# Rate Limiting (prototype: in-memory)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_LLM_MAX=20
RATE_LIMIT_LLM_WINDOW_SECONDS=60
